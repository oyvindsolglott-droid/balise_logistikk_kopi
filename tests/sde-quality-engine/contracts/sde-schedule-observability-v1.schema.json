{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sde.oyvind-solglott.no/contracts/sde-schedule-observability-v1.schema.json",
  "title": "SDE schedule observability record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "repository",
    "workflowName",
    "workflowFile",
    "workflowRef",
    "eventName",
    "eventScheduleExpression",
    "runId",
    "runNumber",
    "runAttempt",
    "headSha",
    "ref",
    "actor",
    "triggeringActor",
    "timezone",
    "triggerClass",
    "triggerMinute",
    "triggerSlotStatus",
    "expectedSlotLocal",
    "expectedSlotUTC",
    "runRecordCreatedAt",
    "runStartedAt",
    "firstJobStartedAt",
    "workflowObservedAt",
    "gateStartedAt",
    "gateCompletedAt",
    "intendedCycle",
    "shouldRun",
    "gateReason",
    "generatorSelected",
    "scheduleCreationDelaySeconds",
    "workflowQueueSeconds",
    "firstJobQueueSeconds",
    "metadataStatus",
    "metadataWarnings",
    "naturalScheduleCandidate",
    "rerun"
  ],
  "properties": {
    "schemaVersion": { "const": "sde-schedule-observability/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "repository": { "type": ["string", "null"] },
    "workflowName": { "type": ["string", "null"] },
    "workflowFile": { "const": ".github/workflows/update-static-data.yml" },
    "workflowRef": { "type": ["string", "null"] },
    "eventName": { "type": ["string", "null"] },
    "eventScheduleExpression": { "type": ["string", "null"] },
    "runId": { "type": ["string", "null"] },
    "runNumber": { "type": ["integer", "null"], "minimum": 1 },
    "runAttempt": { "type": ["integer", "null"], "minimum": 1 },
    "headSha": { "type": ["string", "null"] },
    "ref": { "type": ["string", "null"] },
    "actor": { "type": ["string", "null"] },
    "triggeringActor": { "type": ["string", "null"] },
    "timezone": { "const": "Europe/Oslo" },
    "triggerClass": { "enum": ["CONTROL", "CRITICAL", "MANUAL", "OTHER"] },
    "triggerMinute": { "type": ["integer", "null"], "enum": [7, 17, 22, 37, 52, null] },
    "triggerSlotStatus": {
      "enum": [
        "CONFIRMED_BY_SCHEDULE_EXPRESSION",
        "AMBIGUOUS",
        "NOT_APPLICABLE",
        "BLOCKED"
      ]
    },
    "expectedSlotLocal": { "type": ["string", "null"] },
    "expectedSlotUTC": { "type": ["string", "null"], "format": "date-time" },
    "runRecordCreatedAt": { "type": ["string", "null"], "format": "date-time" },
    "runStartedAt": { "type": ["string", "null"], "format": "date-time" },
    "firstJobStartedAt": { "type": ["string", "null"], "format": "date-time" },
    "workflowObservedAt": { "type": ["string", "null"], "format": "date-time" },
    "gateStartedAt": { "type": ["string", "null"], "format": "date-time" },
    "gateCompletedAt": { "type": ["string", "null"], "format": "date-time" },
    "intendedCycle": { "type": ["string", "null"] },
    "shouldRun": { "type": ["boolean", "null"] },
    "gateReason": { "type": ["string", "null"] },
    "generatorSelected": { "type": ["boolean", "null"] },
    "scheduleCreationDelaySeconds": { "type": ["number", "null"], "minimum": 0 },
    "workflowQueueSeconds": { "type": ["number", "null"], "minimum": 0 },
    "firstJobQueueSeconds": { "type": ["number", "null"], "minimum": 0 },
    "metadataStatus": { "enum": ["GREEN", "BLOCKED", "PARTIAL"] },
    "metadataWarnings": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "naturalScheduleCandidate": { "type": "boolean" },
    "rerun": { "type": ["boolean", "null"] }
  }
}
