{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sde-browserguard-readonly-interaction-plan-v1.schema.json",
  "title": "SDE Browserguard policy-bound read-only interaction plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "targetOrigin", "allowedPaths", "queryPolicy", "viewports", "targets", "actions"],
  "properties": {
    "schemaVersion": {"const": "sde-browserguard-readonly-interaction-plan/v1"},
    "planId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "targetOrigin": {"const": "$BROKER_SENTINEL"},
    "allowedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^/[a-z0-9./-]*$"}},
    "queryPolicy": {"const": "FORBID"},
    "viewports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/viewport"}},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "width": {"type": "integer", "minimum": 1, "maximum": 10000},
        "height": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "reads", "attributes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "selector": {"type": "string", "minLength": 1, "maxLength": 200},
        "reads": {"type": "array", "uniqueItems": true, "items": {"enum": ["TEXT", "ATTRIBUTE", "COUNT", "VISIBLE"]}},
        "attributes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(alt|class|id|role|title|aria-[a-z-]+)$"}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "type": {"enum": ["NAVIGATION", "MENU_TOGGLE", "TAB_SWITCH", "READONLY_DETAIL", "CLOSE_OVERLAY", "FOCUS", "SAFE_KEY"]},
        "path": {"type": "string", "pattern": "^/[a-z0-9./-]*$"},
        "targetId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "expectedTag": {"enum": ["a", "button", "div"]},
        "expectedRole": {"enum": ["button", "tab"]},
        "key": {"enum": ["Tab", "Shift+Tab", "Escape", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End"]},
        "resultKind": {"enum": ["dialog", "popup"]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "NAVIGATION"}}},
          "then": {
            "required": ["path"],
            "not": {"anyOf": [
              {"required": ["targetId"]}, {"required": ["expectedTag"]},
              {"required": ["expectedRole"]}, {"required": ["key"]},
              {"required": ["resultKind"]}
            ]}
          },
          "else": {
            "required": ["targetId", "expectedTag", "expectedRole"],
            "not": {"required": ["path"]}
          }
        },
        {
          "if": {"properties": {"type": {"const": "SAFE_KEY"}}},
          "then": {"required": ["key"]},
          "else": {"not": {"required": ["key"]}}
        },
        {
          "if": {"properties": {"type": {"const": "READONLY_DETAIL"}}},
          "then": {"required": ["resultKind"]},
          "else": {"not": {"required": ["resultKind"]}}
        }
      ]
    }
  }
}
