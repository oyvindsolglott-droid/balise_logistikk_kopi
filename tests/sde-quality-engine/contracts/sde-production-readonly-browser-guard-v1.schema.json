{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sde-production-readonly-browser-guard-v1.schema.json",
  "title": "SDE protected production read-only browser guard report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "createdAt",
    "targetOrigin",
    "browserName",
    "browserVersion",
    "playwrightVersion",
    "serviceWorkersBlocked",
    "httpBarrierInstalled",
    "webSocketBarrierInstalled",
    "barriersInstalledBeforeFirstPage",
    "sentinelProbeStatus",
    "allowedRequestCount",
    "blockedRequestCount",
    "blockedMethods",
    "webSocketsBlocked",
    "popupCoverage",
    "securityWarnings",
    "overallStatus",
    "audit",
    "profileDirectoryDeleted",
    "browserDisconnected",
    "downloadsIsolated",
    "serviceWorkerProbeStatus",
    "webSocketProbeStatus"
  ],
  "properties": {
    "schemaVersion": {"const": "sde-production-readonly-browser-guard/v1"},
    "createdAt": {"type": "string", "format": "date-time"},
    "targetOrigin": {"type": "string", "pattern": "^https?://"},
    "browserName": {"type": "string", "minLength": 1},
    "browserVersion": {"type": "string", "minLength": 1},
    "playwrightVersion": {"type": "string", "minLength": 1},
    "serviceWorkersBlocked": {"type": "boolean"},
    "httpBarrierInstalled": {"type": "boolean"},
    "webSocketBarrierInstalled": {"type": "boolean"},
    "barriersInstalledBeforeFirstPage": {"type": "boolean"},
    "sentinelProbeStatus": {"enum": ["GREEN", "PARTIAL", "BLOCKED", "RED"]},
    "allowedRequestCount": {"type": "integer", "minimum": 0},
    "blockedRequestCount": {"type": "integer", "minimum": 0},
    "blockedMethods": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "webSocketsBlocked": {"type": "integer", "minimum": 0},
    "popupCoverage": {"type": "boolean"},
    "securityWarnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "overallStatus": {"enum": ["GREEN", "PARTIAL", "BLOCKED", "RED"]},
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp",
          "method",
          "origin",
          "path",
          "resourceType",
          "allowed",
          "blocked",
          "barrierReason",
          "pageIdentity"
        ],
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "method": {"type": "string", "minLength": 1},
          "origin": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^/"},
          "resourceType": {"type": "string", "minLength": 1},
          "allowed": {"type": "boolean"},
          "blocked": {"type": "boolean"},
          "barrierReason": {"type": "string", "minLength": 1},
          "pageIdentity": {"type": "string", "pattern": "^(page-[0-9]+|context)$"}
        }
      }
    },
    "profileDirectoryDeleted": {"type": "boolean"},
    "browserDisconnected": {"type": "boolean"},
    "downloadsIsolated": {"type": "boolean"},
    "serviceWorkerProbeStatus": {"enum": ["GREEN", "PARTIAL", "BLOCKED", "RED"]},
    "webSocketProbeStatus": {"enum": ["GREEN", "PARTIAL", "BLOCKED", "RED"]}
  }
}
