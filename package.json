{
  "name": "sde-permanent-regression-firewall",
  "version": "1.0.0",
  "private": true,
  "description": "Permanent test-only firewall for the SDE canonical A-W contracts.",
  "scripts": {
    "test": "npm run test:sde:strict",
    "test:sde:strict": "node tests/sde/strict/strict-runner.cjs",
    "test:sde:baseline-audit": "node tests/sde/strict/baseline-audit.cjs",
    "test:sde:determinism": "node tests/sde/strict/determinism-audit.cjs",
    "test:sde:mutations": "node tests/sde/strict/mutation-audit.cjs && node tests/sde/strict/focused-final-mutation-audit.cjs && node tests/sde/strict/multileg-route-mutation-audit.cjs && node tests/sde/strict/actual-drag-source-mutation-audit.cjs && node tests/sde/strict/vehicle-id-policy-mutation-audit.cjs && node tests/sde/strict/topology-complete-drag-mutation-audit.cjs && node tests/sde/strict/night-plan-ocr-save-mutation-audit.cjs",
    "test:sde:contracts": "node --test --test-concurrency=1 tests/sde/firewall.test.cjs",
    "test:sde:qualification": "npm run test:sde:determinism && npm run test:sde:contracts && npm run test:sde:mutations",
    "test:sde:all": "node tests/sde-quality-engine/run.cjs --suite all",
    "test:sde:multiuser": "node tests/sde-quality-engine/run.cjs --suite multiuser",
    "test:sde:balise": "node tests/sde-quality-engine/run.cjs --suite balise",
    "test:sde:integration": "node tests/sde-quality-engine/run.cjs --suite integration",
    "test:sde:e2e": "node tests/sde-quality-engine/run.cjs --suite e2e",
    "test:sde:regression": "node tests/sde-quality-engine/run.cjs --suite regression",
    "test:sde:production-readonly": "node tests/sde-quality-engine/run.cjs --suite production-readonly",
    "test:sde:report": "node tests/sde-quality-engine/run.cjs --suite report",
    "test:sde:qe:unit": "node --test tests/sde-quality-engine/unit/*.test.cjs",
    "test:sde:qe:policy": "node --test tests/sde-quality-engine/unit/ci-policy.test.cjs",
    "test:sde:qe:provenance": "node --test tests/sde-quality-engine/unit/provenance.test.cjs",
    "test:sde:qe:attestation-identity": "node --test tests/sde-quality-engine/unit/attestation-identity.test.cjs",
    "test:sde:qe:browserguard:runtime": "python3.11 -B tests/sde-quality-engine/browserguard/runtime_contract.py",
    "test:sde:qe:browserguard:foundation": "python3.11 -B -m unittest discover -s tests/sde-quality-engine/browserguard -p 'test_broker_foundation.py' -v && python3.11 -B -m unittest discover -s tests/sde-quality-engine/browserguard -p 'test_evidence_writer.py' -v",
    "test:sde:qe:browserguard:orchestrate": "python3.11 -B tests/sde-quality-engine/browserguard/orchestrate.py",
    "test:sde:qe:browserguard": "python3.11 -B -m unittest discover -s tests/sde-quality-engine/browserguard -p 'test_*.py' -v",
    "test:sde:menu-browser": "python3.11 -B -m unittest -v tests/sde/test_menu_access_layout_e2e.py",
    "test:sde:empty-target-browser": "python3.11 -B -m unittest -v tests/sde/test_empty_target_drag_e2e.py",
    "test:sde:chain-liveness-browser": "python3.11 -B -m unittest -v tests/sde/test_chain_liveness_drag_e2e.py",
    "test:sde:qe:ci": "node tests/sde-quality-engine/run.cjs --suite ci",
    "test:sde:prepush": "node --test --test-concurrency=1 tests/sde-quality-engine/prepush-gate.test.cjs",
    "sde:prepush:install": "node scripts/sde-prepush-gate.cjs install",
    "sde:prepush:doctor": "node scripts/sde-prepush-gate.cjs doctor",
    "sde:prepush:approve": "node scripts/sde-prepush-gate.cjs approve"
  },
  "engines": {
    "node": ">=24"
  }
}
